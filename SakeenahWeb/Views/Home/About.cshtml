
@{
    Layout = "_SakeenahLayout";
    ViewData["Title"] = "About Us";
}

<section id="about" class="content-card">
    <h2 class="about-heading">About Sakeenah</h2>

    <p>
        Sakeenah is an Islamic website designed
        to help users discover Duas based on
        their emotions and explore daily Adhkar
        and Sunnah practices.
    </p>
</section>

<section id="purpose" class="content-card">
    <h2>Our Purpose</h2>

    <p>
        Our goal is to make Islamic remembrance
        easier to access and encourage users
        to include Duas and Adhkar in their
        daily lives.
    </p>
</section>

<section id="features" class="content-card">
    <h2>What We Offer</h2>

    <ul class="about-list">
        <li>Duas based on emotions</li>
        <li>Daily Adhkar</li>
        <li>Sunnah practices</li>
        <li>A simple and peaceful experience</li>
    </ul>
</section>