
@{
    Layout = "_SakeenahLayout";
    ViewData["Title"] = "Home";
    ViewData["BodyClass"] = "home-page";
}

@section Styles {
    <style>
        .home-subtitle {
            text-align: center;
            color: #6B7350;
            font-size: 17px;
        }
    </style>
}

<section id="welcome" class="hero-section">
    <div class="hero-label-position">
        <span class="hero-label">A Moment of Peace</span>
    </div>

    <h2>Find Comfort Through Remembrance</h2>

    <p class="home-subtitle">
    @if (ViewData["Language"]?.ToString() == "ar")
    {
        <span dir="rtl">
            مرحبًا بك في سكينة، مساحة هادئة لاستكشاف الأدعية والأذكار والسنن.
        </span>
    }
    else
    {
        <span>
            Welcome to Sakeenah, a peaceful space to explore Duas, Adhkar, and Sunnah.
        </span>
    }
</p>
<form asp-controller="Home" asp-action="SetLanguage" method="post">

    <div class="emotion-buttons">

        <button type="submit" name="language" value="en" class="emotion-button">
            English
        </button>

        <button type="submit" name="language" value="ar" class="emotion-button">
            العربية
        </button>

    </div>

</form>
</section>

<section id="emotions" class="content-card">
    <h2>How Are You Feeling Today?</h2>

    <p>Select an emotion to discover a Dua.</p>

    <form asp-controller="Home" asp-action="SelectEmotion" method="post">

    <div class="emotion-buttons">

        <button type="submit" name="emotion" value="sad" class="emotion-button">Sad</button>

        <button type="submit" name="emotion" value="anxious" class="emotion-button">Anxious</button>

        <button type="submit" name="emotion" value="grateful" class="emotion-button">Grateful</button>

        <button type="submit" name="emotion" value="happy" class="emotion-button">Happy</button>

    </div>

</form>
@if (ViewData["SelectedEmotion"] != null)
{
    <p>You selected: @ViewData["SelectedEmotion"]</p>
}

    <table width="100%">
        <tr>
            <td id="image-cell" width="30%" style="display: none;">
                <img id="emotion-image"
                     alt="Emotion illustration"
                     width="140"
                     style="display: none;">
            </td>

            <td>
                <div id="dua-result" class="dua-result">
                    <p>Your Dua will appear here.</p>
                </div>
            </td>
        </tr>
    </table>
</section>

<section id="adhkar" class="content-card">
    <h2>Daily Adhkar | الأذكار اليومية</h2>

    <p>
        Remember Allah throughout your day
        with daily Adhkar.
    </p>

    <ul>
        <li>Morning Adhkar</li>
        <li>Evening Adhkar</li>
        <li>Before Sleeping</li>
        <li>After Prayer</li>
    </ul>

    <button type="button" class="adhkar-button"
            onclick="showAdhkarChecklist()">
        My Daily Adhkar Checklist
        <span id="adhkar-arrow" class="adhkar-arrow">▼</span>
    </button>

    <div id="adhkar-checklist" class="adhkar-checklist" style="display: none;"></div>

    <h3>Daily Remembrance Guide</h3>

    <table class="adhkar-table">
        <tr>
            <th>Time</th>
            <th>Adhkar</th>
        </tr>
        <tr>
            <td>Morning</td>
            <td>Morning Adhkar</td>
        </tr>
        <tr>
            <td>Evening</td>
            <td>Evening Adhkar</td>
        </tr>
        <tr>
            <td>Before Sleep</td>
            <td>Sleeping Adhkar</td>
        </tr>
    </table>
</section>

<section id="sunnah" class="content-card">
    <h2>Daily Sunnah | السنن اليومية</h2>

    <p>
        Discover simple Sunnah practices
        to include in your daily life.
    </p>

    <ul>
        <li>Saying Bismillah before eating</li>
        <li>Greeting others with Salam</li>
        <li>Eating with the right hand</li>
    </ul>

    <article class="content-card">
        <h3 id="sunnah-title">Sunnah Spotlight</h3>
        <p>
            Begin your meals by saying Bismillah.
            This is a simple Sunnah that we can
            practice every day.
        </p>
    </article>
</section>

@section Scripts {
    <script src="/js/script.js"></script>

    <script>
        document.getElementById("sunnah-title").innerHTML =
            "Sunnah Spotlight - Daily Reminder";
    </script>

    @if (ViewData["SelectedEmotion"] != null)
    {
        <script>
            showDua('@ViewData["SelectedEmotion"]');
        </script>
    }
}